{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "src/main.ts",
    "src/cli-entry.ts",
    "src/**/composition/*.ts",
    "scripts/**/*.ts",
    "src/**/*.spec.ts",
    "test/**/*.ts"
  ],
  "project": ["src/**/*.ts"],
  "rules": {
    "files": "error",
    "exports": "warn",
    "types": "off",
    "nsExports": "off",
    "classMembers": "off",
    "dependencies": "error",
    "devDependencies": "error"
  },
  "ignore": [
    "src/auth/infrastructure/messaging/audit-security-alert.reaction.ts",
    "src/auth/infrastructure/messaging/durable-reaction-worker.ts",
    "src/shared/application/ports/reaction-executor.interface.ts"
  ],
  "ignoreExports": [
    "src/**/*.ts"
  ],
  "ignoreDependencies": [
    "@nestjs/schematics",
    "@stryker-mutator/jest-runner",
    "@stryker-mutator/typescript-checker",
    "@types/jest",
    "@aws-sdk/lib-dynamodb",
    "helmet",
    "tsconfig-paths"
  ]
}
