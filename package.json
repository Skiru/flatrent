{
  "name": "flatren",
  "version": "1.0.0",
  "description": "Flatren — modular monolith NestJS with Onion Architecture, DDD, CQRS, and MiniStack",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.13.1"
  },
  "scripts": {
    "nest": "nest",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "architecture:check": "dependency-cruiser --config .dependency-cruiser.js src",
    "deadcode:check": "knip",
    "test": "jest",
    "test:unit": "jest --config jest-unit.json",
    "test:application": "jest --config jest-application.json",
    "test:integration": "jest --config jest-integration.json",
    "test:e2e:http": "jest --config jest-e2e-http.json",
    "test:e2e:cli": "jest --config jest-e2e-cli.json",
    "test:e2e:module-api": "jest --config jest-e2e-module-api.json",
    "test:e2e:messaging": "jest --config jest-e2e-messaging.json",
    "test:faults": "jest --config jest-faults.json",
    "test:migrations": "jest --config jest-migrations.json",
    "test:mutation": "stryker run",
    "infra:up": "docker compose up -d ministack",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f ministack",
    "infra:ps": "docker compose ps",
    "infra:bootstrap": "ts-node scripts/local/bootstrap-ministack.ts",
    "infra:doctor": "ts-node scripts/local/doctor-ministack.ts",
    "infra:reset": "curl -fsS -X POST \"http://localhost:4566/_ministack/reset?init=1\" || true",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:application",
    "verify:full": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:application && pnpm infra:up && pnpm infra:bootstrap && pnpm infra:doctor && pnpm test:integration && pnpm test:e2e:http && pnpm test:e2e:cli && pnpm test:e2e:module-api && pnpm test:e2e:messaging && pnpm test:faults && pnpm test:migrations && pnpm infra:down"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.525.0",
    "@aws-sdk/client-sns": "3.525.0",
    "@aws-sdk/client-sqs": "3.525.0",
    "@aws-sdk/lib-dynamodb": "3.525.0",
    "@nestjs/common": "11.0.1",
    "@nestjs/core": "11.0.1",
    "@nestjs/cqrs": "11.0.1",
    "@nestjs/passport": "11.0.1",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/typeorm": "11.0.0",
    "argon2": "0.40.1",
    "helmet": "7.1.0",
    "ioredis": "5.3.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.11.3",
    "reflect-metadata": "0.2.1",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@aws-sdk/client-elasticache": "3.525.0",
    "@aws-sdk/client-rds": "3.525.0",
    "@nestjs/cli": "11.0.1",
    "@nestjs/schematics": "11.0.1",
    "@nestjs/testing": "11.0.1",
    "@stryker-mutator/core": "^8.0.0",
    "@stryker-mutator/jest-runner": "^8.0.0",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "20.11.20",
    "@types/passport": "1.0.16",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.11.0",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.0.2",
    "@typescript-eslint/parser": "7.0.2",
    "dependency-cruiser": "16.2.2",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "knip": "5.0.1",
    "prettier": "3.2.5",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
